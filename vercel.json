{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "chmod +x scripts/render_build_web.sh && ./scripts/render_build_web.sh",
  "outputDirectory": "dailystack/build/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
